{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "verify: no eabi imports",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/mb10pro/platform/verify_no_eabi.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "build mb10p hello | 3.101.043",
            "dependsOrder": "sequence",
            "dependsOn": [
                "compile mb10p hello | 3.101.043",
                "link mb10p hello | 3.101.043",
                "verify: no eabi imports",
                "deploy mb10p hello | 3.101.043"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "compile mb10p hello | 3.101.043",
            "command": "arm-none-eabi-gcc",
            "args": [
                "-mcpu=cortex-m33",
                "-mthumb",
                "-mfloat-abi=soft",
                "-ffreestanding",
                "-fno-common",
                "-fno-builtin",
                "-nostdlib",
                "-fno-jump-tables",
                "-fno-stack-protector",
                "-fno-unwind-tables",
                "-fno-asynchronous-unwind-tables",
                "-fdata-sections",
                "-fno-function-sections",
                "-Os",
                "-Imb10pro",
                "-DMB10P_FW_VERSION=3101043",
                "-Wall",
                "-Wextra",
                "-c",
                "mb10pro/mb10p_hello.c",
                "-o",
                "mb10p_hello.o"
            ],
            "problemMatcher": []
        },
        {
            "label": "link mb10p hello | 3.101.043",
            "command": "arm-none-eabi-gcc",
            "args": [
                "-mcpu=cortex-m33",
                "-mthumb",
                "-mfloat-abi=soft",
                "-r",
                "-T",
                "mb10pro/mb10pro.ld",
                "-o",
                "mb10p_hello_3.101.043.elf",
                "mb10p_hello.o"
            ],
            "problemMatcher": []
        },
        {
            "label": "deploy mb10p hello | 3.101.043",
            "type": "shell",
            "command": "Copy-Item",
            "args": [
                "-Path",
                "${workspaceFolder}/mb10p_hello_3.101.043.elf",
                "-Destination",
                "${workspaceFolder}/mb10pro/wf_native_hello/app/lua",
                "-Force"
            ],
            "problemMatcher": []

        },
        {
            "label": "compile: mb10p calc page | 3.101.043",
